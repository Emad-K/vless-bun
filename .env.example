# VLESS Server Configuration

# Your unique UUID for authentication
# Generate one with: uuidgen or https://www.uuidgenerator.net/
UUID=4c1fe881-420d-4c23-8b26-5bb66101687b

# Proxy IP for fallback connections (optional)
PROXYIP=

# Server port (inside container; map host port with docker-compose `ports`)
PORT=3000

# Logging: debug | info | warn | error | silent
LOG_LEVEL=info

# Subscription URL overrides (Docker: set PUBLIC_HOST to your LAN/WSL IP or domain)
PUBLIC_HOST=
PUBLIC_PORT=

# Generate tls+wss client URLs (true behind nginx/Caddy). Default false = plain WS on PORT.
TLS=false
