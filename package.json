{
  "name": "vless-bun",
  "version": "1.0.0",
  "description": "VLESS proxy server running on Bun",
  "type": "module",
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun run --watch src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun"
  },
  "dependencies": {
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.7"
  }
}
